{
  "YoutubeMusic": {
    "BaseUrl": "http://127.0.0.1:26538"
  },
  "QueuePolicy": {
    "RepeatCooldownMinutes": 10,
    "PreferredVideos": {}
  },
  "Twitch": {
    "RedirectUri": "http://localhost:5161/api/twitch/callback",
    "Commands": {
      "SongRequestsEnabled": true,
      "UserCooldownSeconds": 30,
      "GlobalCooldownSeconds": 2,
      "MaxQueryLength": 150
    }
  },
  "Discord": {
    "Enabled": false,
    "AllowedChannelIds": [],
    "Commands": {
      "UserCooldownSeconds": 30,
      "GlobalCooldownSeconds": 2,
      "MaxQueryLength": 150,
      "VideoRequesterUsername": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
